// ~/.config/waybar/config.jsonc — clean layout, no tray (looks come later)
{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 6,
  "modules-left": [
    "hyprland/workspaces"
    // "mpris"
  ],
  // "modules-center": [ "clock" ],
  "modules-center": ["clock#day", "clock", "clock#date"],
  "modules-right": [

    "custom/updates",
    "power-profiles-daemon",
    "backlight",
    "wireplumber",
    "network",
    "battery",
    "custom/arch"
  ],
  "hyprland/workspaces": {
    "format": "{id}",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "sort-by": "number"
  },
    "clock#day": {
    "format": "{:%a}",
    "on-click": "~/.config/rofi/spotlight",
    "min-length": 8,
    "align": 1,
    "tooltip": false
  },
  "clock": {
    // "format": "{:%H:%M [%a] [%d %b]}",
    "format": "{:%H:%M}",
    "on-click": "~/.config/rofi/spotlight",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "clock#date": {
    "format": "{:%d %b}",
    "on-click": "~/.config/rofi/spotlight",
    "min-length": 8,
    "align": 0,
    "tooltip": false
  },
  // "clock": {
  //   "format": "{:%H:%M [%a] [%d %b]}",
  //   "tooltip-format": "<tt>{calendar}</tt>",
  //   "calendar": {
  //     "mode": "month",
  //     "weeks-pos": "",
  //     "on-scroll": 1
  //   }
  // },
  "mpris": {
    "format": "{status_icon} {dynamic}",
    "max-length": 20,
    "dynamic-order": [
      "title",
      "artist"
    ],
    "dynamic-len": 40,
    "status-icons": {
      "playing": "",
      "paused": ""
    },
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "return-type": "json",
    "interval": 3600,
    "signal": 8,
    "hide-empty-text": true,
    "format": "󰥔 {}",
    "on-click": "${TERMINAL:-kitty} -e sh -c 'yay -Syu || sudo pacman -Syu; pkill -RTMIN+8 waybar'"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}",
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
  },
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": [
      "󰕿",
      "󰖀",
      "󰕾"
    ],
    "scroll-step": 5,
    "max-volume": 100,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },
  "network": {
    "format-wifi": "{icon} {essid}",
    "format-ethernet": "󰈀 wired",
    "format-disconnected": "󰤮 offline",
    "format-icons": [
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "on-click": "${TERMINAL:-kitty} -e nmtui"
  },
  "battery": {
    "states": {
      "warning": 25,
      "critical": 12
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁻",
      "󰁽",
      "󰁿",
      "󰂁",
      "󰁹"
    ],
    "tooltip-format": "{timeTo}\n{power:.1f} W"
  },
  "custom/arch": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout"
  }
}
